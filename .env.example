# Chế độ lưu dữ liệu: local hoặc supabase
VITE_STORAGE_MODE=local

# Chỉ cần điền khi VITE_STORAGE_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL của dịch vụ GitHub OAuth/đồng bộ configure.json (cần khi dùng GitHub)
VITE_SYNC_API_URL=

# GitHub Device Flow: chỉ cần OAuth App Client ID (không đặt Client Secret ở đây)
VITE_GITHUB_OAUTH_CLIENT_ID=
VITE_GITHUB_REPOSITORY=phuongbeobn/NoiBai-Airport-System
VITE_GITHUB_CONFIG_PATH=configure.json
